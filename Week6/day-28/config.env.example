# ==============================================================================
# Client Configuration File (Edit in Notepad — never touch Python code!)
# ==============================================================================

# 1. Your Business Details (used in reply sign-offs, page header, and footer)
BUSINESS_NAME="Savannah Customer Care"
MANAGER_NAME="Customer Care Team"
BUSINESS_TYPE="small Kenyan business (shop, courier service, Airbnb, or restaurant)"
REPLY_TONE="warm, polite, calm, and respectful Kenyan business tone"
SUPPORT_EMAIL="support@yourbusiness.co.ke"
SUPPORT_PHONE="+254 700 000 000"

# 2. Branding & Display (shown on the web tool)
APP_TITLE="Customer Complaint Reply Drafter"
APP_SUBTITLE="Paste a customer complaint message below to instantly generate a polite, professional reply draft."
COPYRIGHT_OWNER=""
COPYRIGHT_YEAR="2026"
BRAND_PRIMARY_COLOR="#059669"
BRAND_ACCENT_COLOR="#25D366"

# 3. AI Settings (Optional: leave GEMINI_API_KEY blank to use the built-in offline engine)
GEMINI_API_KEY=""
GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash"
GEMINI_TEMPERATURE="0.4"
GEMINI_MAX_TOKENS="600"
API_TIMEOUT_SECONDS="12"

# 4. Input Limits & Files
MIN_COMPLAINT_CHARS="3"
MAX_COMPLAINT_CHARS="3000"
SAMPLES_FILE="samples.json"

# 5. Server Settings
HOST="0.0.0.0"
PORT="5000"
AUTO_OPEN_BROWSER="true"
