# =====================================================================
# Nairobi Retail Sales Automation - Environment Configuration
# =====================================================================

# Sender Gmail Address (e.g. retail shop system or owner's email)
GMAIL_ADDRESS=your_shop_reports@gmail.com

# Google App Password (16 characters generated via Google Account Security)
# NOTE: Do NOT use your standard Gmail login password. Generate an App Password:
# 1. Enable 2-Step Verification in Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create app name 'Retail Sales Reporter' and copy the 16-character code.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Target Email Address for Daily 6:00 PM Reports (Defaults to GMAIL_ADDRESS if omitted)
REPORT_RECIPIENT=shop_owner@example.com

# Shop Configuration
SHOP_NAME=Zawadi Mini-Mart & Retail
SHOP_LOCATION=Westlands, Nairobi, Kenya
REPORT_TIME_EAT=18:00
DEFAULT_RESTOCK_THRESHOLD=10
